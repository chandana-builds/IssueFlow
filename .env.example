# Application Settings
APP_NAME=IssueFlow
APP_VERSION=1.0.0
DEBUG=True

# Database Configuration (SQLite default; can point to PostgreSQL)
DATABASE_URL=sqlite:///./issueflow.db

# JWT Security
SECRET_KEY=issueflow-change-in-production-super-secret-key-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (Comma-separated list or "*")
CORS_ORIGINS=["*"]
